	<string>MacOSAppStarter needs Apple Events to demonstrate Accessibility integration.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Xueshi Qiao. All rights reserved.</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://xueshiqiao.github.io/macos-app-starter/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>PLACEHOLDER_REPLACE_WITH_REAL_ED25519_PUBLIC_KEY</string>
